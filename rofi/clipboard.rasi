
@import "../generated/rofi-colors.rasi"

configuration {
    modi: "drun";
    show-icons: false;
    display-drun: "Clipboard";
}

* {
    font: "JetBrainsMono Nerd Font 11";
    text-color: @foreground;
}

window {
    width: 580px;
    border: 1px;
    border-color: @accent;
    border-radius: 20px;
    background-color: @background;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @secondary;
    border-radius: 14px;
    padding: 14px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: @foreground;
    placeholder: "Search clipboard history...";
    placeholder-color: @muted;
    background-color: transparent;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 10;
    fixed-height: false;
    spacing: 5px;
    scrollbar: false;
}

element {
    background-color: @background;
    text-color: @foreground;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    padding: 11px;
    spacing: 12px;
}

element normal.normal {
    background-color: @background;
    text-color: @foreground;
}

element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected {
    background-color: @secondary;
    text-color: @foreground;
    border: 1px;
    border-color: @accent;
    border-radius: 12px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

