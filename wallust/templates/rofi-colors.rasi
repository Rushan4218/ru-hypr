/* Generated by Wallust — do not edit manually. */
* {
    background: #{{ background | strip }}80;
    foreground: #{{ foreground | strip }};
    accent: #{{ color6 | strip }};
    secondary: #{{ color2 | strip }}CC;
    tertiary: #{{ color1 | strip }};
    muted: #{{ color4 | strip }};
    surface: #{{ color0 | strip }}80;
}
