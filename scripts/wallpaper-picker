#!/usr/bin/env bash
set -euo pipefail

CONFIG="$HOME/.config/ru-hypr"
WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
CACHE_DIR="$HOME/.cache/ru-hypr/wallpaper-thumbnails"
THEME="$CONFIG/rofi/wallpaper-picker.rasi"
SETTER="$CONFIG/scripts/set-wallpaper"
THUMB_SIZE="320x180"

notify() {
    notify-send -a "Wallpaper Picker" "Wallpaper Picker" "$1" 2>/dev/null || echo "$1" >&2
}

for cmd in rofi magick find md5sum xargs; do
    command -v "$cmd" >/dev/null || { notify "Missing dependency: $cmd"; exit 1; }
done

[[ -d "$WALLPAPER_DIR" ]] || { notify "Folder not found: $WALLPAPER_DIR"; exit 1; }
[[ -x "$SETTER" ]]        || { notify "Setter script not executable: $SETTER"; exit 1; }

mkdir -p "$CACHE_DIR"

# Thumbnail name is a hash of the full path, so a.jpg / a.png or
# files with the same name in different subfolders never collide.
thumb_path() {
    printf '%s/%s.png' "$CACHE_DIR" "$(printf '%s' "$1" | md5sum | cut -d' ' -f1)"
}

make_thumb() {
    local file=$1 thumb
    thumb="$(thumb_path "$file")"
    [[ -f "$thumb" && ! "$file" -nt "$thumb" ]] && return 0
    # write to a temp file first so an interrupted run never leaves a broken thumbnail
    if magick "${file}[0]" -thumbnail "${THUMB_SIZE}^" \
        -gravity center -extent "$THUMB_SIZE" "${thumb}.tmp.png" 2>/dev/null; then
        mv -f "${thumb}.tmp.png" "$thumb"
    else
        rm -f "${thumb}.tmp.png"
    fi
    return 0
}
export -f make_thumb thumb_path
export CACHE_DIR THUMB_SIZE

mapfile -d '' -t files < <(
    find -L "$WALLPAPER_DIR" -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.webp' -o -iname '*.avif' \) -print0 | sort -z
)

((${#files[@]} > 0)) || { notify "No supported wallpapers found in $WALLPAPER_DIR"; exit 1; }

# Generate missing thumbnails in parallel (first run is much faster)
printf '%s\0' "${files[@]}" |
    xargs -0 -n1 -P "$(nproc)" bash -c 'make_thumb "$1"' _

# Keep only files that have a valid thumbnail
valid=()
for f in "${files[@]}"; do
    [[ -f "$(thumb_path "$f")" ]] && valid+=("$f")
done

((${#valid[@]} > 0)) || { notify "Could not generate any thumbnails"; exit 1; }

# Stream entries straight into rofi (no $(...) capture of the list, so the \0 survives).
# -format i returns the index, so names never need to be matched back to paths.
idx="$(
    for f in "${valid[@]}"; do
        name="${f##*/}"
        printf '%s\0icon\x1f%s\n' "$name" "$(thumb_path "$f")"
    done | rofi -dmenu -i -show-icons -format i \
            -p "Wallpapers" -theme "$THEME"
)" || exit 0

[[ -n "$idx" ]] || exit 0
exec "$SETTER" "${valid[$idx]}"
